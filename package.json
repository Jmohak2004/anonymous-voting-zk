{
  "name": "anonymous-voting-zk",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous on-chain voting with zero-knowledge proofs (Circom + Groth16 + Hardhat + React)",
  "scripts": {
    "test:circuits": "mocha -r ts-node/register \"circuits/test/*.test.ts\" --timeout 300000",
    "build:circuit": "bash scripts/build-circuit.sh",
    "smoke": "ts-node scripts/smoke-prove.ts",
    "chain": "hardhat node",
    "deploy:local": "hardhat run --network localhost scripts/deploy.ts",
    "test": "hardhat test",
    "e2e": "hardhat run scripts/e2e.ts",
    "test:frontend": "npm --prefix frontend test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test:all": "npm run test:circuits && npm test && npm run test:frontend && npm run e2e"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^4.5.0",
    "circom_tester": "^0.0.24",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "dotenv": "^18.0.10",
    "hardhat": "^2.29.2",
    "mocha": "^12.0.3",
    "poseidon-solidity": "^0.0.5",
    "snarkjs": "^0.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
